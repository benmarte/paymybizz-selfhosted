# PayMyBizz — Self-Hosted Configuration
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.dist.example .env
#
# Then start the app:
#   docker compose -f docker-compose.dist.yml up -d

# ======================
# Convex Backend
# ======================
CONVEX_PORT=3210
SITE_PROXY_PORT=3211
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
RUST_LOG=info
DOCUMENT_RETENTION_DELAY=172800

# ======================
# Convex Dashboard
# ======================
DASHBOARD_PORT=6791
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# ======================
# Frontend
# ======================
FRONTEND_PORT=8177
AUTH_SITE_URL=http://localhost:8177

# ======================
# Deployment Mode
# ======================
# "saas" = per-org Stripe billing | "selfhosted" = no billing (default)
DEPLOYMENT_MODE=selfhosted

# ======================
# Google OAuth (optional)
# ======================
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret

# ======================
# Email (optional — pick ONE provider)
# ======================
# Gmail:
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your-app-password
# Resend:
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM=invoices@yourdomain.com

# ======================
# Stripe — Invoice Payments (optional)
# ======================
# STRIPE_SECRET_KEY=sk_live_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ======================
# Cloudflare Tunnel (optional — for remote/mobile access)
# ======================
# 1. Create a tunnel at https://one.dash.cloudflare.com/
# 2. Set TUNNEL_TOKEN to your tunnel's token
# 3. Override the Convex URLs to your tunnel domains:
# TUNNEL_TOKEN=your-tunnel-token-here
# CONVEX_CLOUD_ORIGIN=https://api.yourdomain.com
# CONVEX_SITE_ORIGIN=https://site.yourdomain.com
# NEXT_PUBLIC_DEPLOYMENT_URL=https://api.yourdomain.com
# AUTH_SITE_URL=https://app.yourdomain.com
